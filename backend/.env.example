# Optional. Relative paths are resolved from the repository root, independent of cwd.
EARTHSCOPE_DATA_PATH=data/raw/giovanni_merra2_gambia_t2m_1991_2025.csv

# Directory for the five additional approved /v2 CSVs (fixed filenames).
# T2M in both APIs still uses EARTHSCOPE_DATA_PATH. No manifest overrides.
EARTHSCOPE_V2_DATA_DIR=data/raw

# Comma-separated exact HTTP(S) origins. Setting this replaces the local defaults.
# An empty value disables cross-origin browser access. No wildcard or credentials.
EARTHSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
